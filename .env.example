# Kopieren nach .env.local und ausfüllen.
#
# Ohne diese Werte startet die App im lokalen Modus: kein Login, alle Daten
# in IndexedDB auf genau diesem Gerät. Das ist ein gültiger Zustand zum
# Ausprobieren - nur geteilte Listen und Sync gibt es dort nicht.

# Projekt-URL aus dem Supabase-Dashboard (Settings -> API -> Project URL)
VITE_SUPABASE_URL=

# Der öffentliche anon-Key aus demselben Bildschirm.
# Der gehört ins Frontend und ist kein Geheimnis - was ein Client sehen darf,
# entscheiden die RLS-Policies, nicht dieser Schlüssel.
# Der service_role-Key dagegen umgeht RLS vollständig und darf NIE hier landen.
VITE_SUPABASE_ANON_KEY=

# Basis-URL für Einladungslinks, z. B. https://planner.example.com
# Ohne Angabe wird window.location.origin verwendet - in der Desktop-App wäre
# das tauri://localhost und damit für andere nicht aufrufbar.
VITE_PUBLIC_APP_URL=

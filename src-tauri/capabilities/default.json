{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Basisrechte, Deep-Link (OAuth-Rueckweg), Opener fuer den Systembrowser, Updater und Neustart nach dem Einspielen",
  "windows": [
    "main",
    "panel"
  ],
  "permissions": [
    "core:default",
    "deep-link:default",
    "opener:allow-open-url",
    "opener:allow-default-urls",
    "updater:default",
    "process:allow-restart"
  ]
}

<?xml version="1.0" encoding="utf-8"?>
<!--
  Eine Aufgabenzeile. Der Punkt links traegt die Listenfarbe; sie wird zur
  Laufzeit ueber setColorFilter gesetzt, deshalb ist die Vorlage weiss.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/planner_widget_item_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingTop="5dp"
    android:paddingBottom="5dp">

    <ImageView
        android:id="@+id/planner_widget_item_dot"
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:src="@drawable/planner_widget_dot"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="9dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/planner_widget_item_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:textColor="@color/planner_widget_ink"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/planner_widget_item_meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="10sp"
            android:textColor="@color/planner_widget_muted"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

</LinearLayout>

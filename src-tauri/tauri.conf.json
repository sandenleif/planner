{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Planner",
  "version": "1.0.0",
  "identifier": "de.leifsanden.planner",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Planner",
        "width": 1080,
        "height": 720,
        "minWidth": 380,
        "minHeight": 480,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "titleBarStyle": "Visible"
      },
      {
        "label": "panel",
        "url": "index.html#/panel",
        "title": "Planner",
        "width": 380,
        "height": 520,
        "resizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "focus": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "connect-src": [
          "'self'",
          "ipc:",
          "http://ipc.localhost",
          "https://*.supabase.co",
          "wss://*.supabase.co"
        ],
        "script-src": "'self'",
        "style-src": [
          "'self'",
          "'unsafe-inline'"
        ],
        "img-src": [
          "'self'",
          "data:",
          "blob:",
          "https:"
        ],
        "font-src": [
          "'self'",
          "data:"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Aufgaben und geteilte Listen",
    "longDescription": "Aufgaben mit Unterpunkten, geteilte Listen, Wiederholungen und Schnellerfassung in natuerlicher Sprache - auf Windows, macOS, Android und im Browser.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "planner"
        ]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEEyQkNCQjRDOUNFNTEzMzYKUldRMkUrV2NUTHU4b3RFVmlsNGRXUHdyOTZ1b3d0M0JIbDVPekxrMWttNWFuTVN6a2dCdUtGaE8K",
      "endpoints": [
        "https://github.com/sandenleif/planner/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}

{
  // Cloudflare Workers mit Static Assets. Es gibt keinen Worker-Code - die
  // App ist rein statisch, Cloudflare liefert nur den dist-Ordner aus.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "planner",
  "compatibility_date": "2026-08-20",

  "assets": {
    "directory": "./dist",

    // Hash-Routing bedeutet, dass alle Routen unter "/" liegen (/#/list/…).
    // Trotzdem SPA-Modus: so bekommt jemand, der eine alte oder vertippte
    // Adresse aufruft, die App statt einer 404-Seite.
    "not_found_handling": "single-page-application"
  },

  // Die Security-Header stehen in public/_headers und landen beim Build in
  // dist/. Workers Static Assets liest die Datei von dort - verifiziert
  // gegen die laufende Bereitstellung.

  // Eigene Domain: erst eintragen, wenn die Zone bei Cloudflare liegt.
  // Vorher schlaegt `wrangler deploy` mit einem Zonenfehler fehl.
  //
  // "routes": [
  //   { "pattern": "planner.leifsanden.com", "custom_domain": true }
  // ],

  "observability": {
    "enabled": true
  }
}
